
c = #00ff99

*
  box-sizing border-box

:root
  font-size 14px

html
body
  display flex
  flex-direction column
  flex 1
  margin 0
  padding 0
  width 100%
  height 100%

body
  background-color #d3cbc2
  background-image url("../img/bg.jpg")
  background-repeat no-repeat
  background-position center bottom
  background-size cover
  color #222
  font-family "Exo", sans-serif

  &.layout-map
    background #e9f7ff

body, td, th
  font-size 1rem

#title
  display flex
  margin auto 5vw
  padding 0
  > a
    display block
    margin 0
    color #222
    text-decoration none
    > strong
    > em
      display block
      font-style normal
    > strong
      font-weight 800
      font-size 4rem
    > em
      font-weight 300
      font-size 1.75rem
      opacity .5

#map
  flex 1
