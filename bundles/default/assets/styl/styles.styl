
c = #0077cc
c_dark = #032b4f
c_landing_bg = #d3cbc2
c_map_bg = #e9f7ff

f_main = "Exo", sans-serif
f_mono = "Lilex", monospace

::selection
  background c
  color white

sr()
  position absolute
  overflow hidden
  left -10000px
  top auto
  width 1px
  height 1px

loader(color = white, size = 40px, thickness = 3px)
  display inline-block
  position relative
  width size
  height @width
  color color
  &
  div
    box-sizing border-box
  div
    display block
    position absolute
    margin thickness
    width size - (2 * thickness)
    height @width
    border thickness solid currentColor
    border-radius 50%
    animation loader 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite
    border-color currentColor transparent transparent transparent
    &:nth-child(1)
      animation-delay -0.45s
    &:nth-child(2)
      animation-delay -0.3s
    &:nth-child(3)
      animation-delay -0.15s

@keyframes loader {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

bt()
  display flex
  align-items center
  justify-content center
  flex 1
  margin 0 5px
  padding 10px
  background #666
  border none
  border-radius 20px
  color #eee
  text-decoration none
  font-weight bold
  .material-symbols-outlined:has(+ span:not(.sr))
    margin-right .35em

bt-stretch()
  flex 0 0 auto
bt-primary()
  background c

.loader
  loader()

.sr
  sr()

.off
  display none !important

*
  box-sizing border-box

:root
  font-size 14px

html
body
  display flex
  flex-direction column
  flex 1
  margin 0
  padding 0
  width 100%
  height 100%

body
  background-color c_landing_bg
  background-image url("../img/bg.jpg")
  background-repeat no-repeat
  background-position center bottom
  background-size cover
  color #222
  user-select none

  &.layout-map
    background black

body, td, th, input, select, textarea, button
  font-family f_main
  font-size 1rem

#wrap
  position relative
  flex 1
  #wrapper
    display flex
    flex-direction column
    position absolute
    overflow-x hidden
    overflow-y auto
    left 0
    right 0
    top 0
    bottom 0

#title
  display flex
  margin auto 5vw
  padding 0
  > a
    display block
    margin 0
    color #222
    text-decoration none
    > strong
    > em
      display block
      font-style normal
    > strong
      font-weight 800
      font-size 4rem
    > em
      font-weight 300
      font-size 1.75rem
      opacity .5

body.layout-map

  .material-symbols-outlined
    font-size 1.25em

  #loading
    display flex
    position absolute
    align-items center
    justify-content center
    overflow hidden
    left 0
    right 0
    top 0
    bottom 0
    z-index 100
    &:before
    &:after
      display block
      position absolute
      content ""
    &:before
      left -20px
      right -20px
      top -20px
      bottom -20px
      background url("../img/bg-sm.jpg") no-repeat center center c_landing_bg
      background-size cover
      filter: blur(10px);
      z-index 1
    &:after
      left 0
      right 0
      top 0
      bottom 0
      background alpha(black, .8)
      z-index 2
    > div
      position relative
      text-align center
      z-index 3
      > .loader
        //
      > p
        margin 10px 0 0 0
        padding 0
        color white
        font-weight bold
        font-size .9rem

  #header
    display flex
    position absolute
    align-items center
    left 0
    right 0
    top 0
    background black
    box-shadow 0 0 20px alpha(black, .5)
    z-index 2
    > a#logo
      display block
      padding 10px
      &:before
        display block
        aspect-ratio 1
        width 35px
        background url("../img/logo.svg") no-repeat
        background-size 100%
        content ""
    > div
      flex 1
      margin 0 10px 0 0
      > form
        display flex
        margin 0
        padding 0
        border 1px solid #999
        border-radius 10rem
        > input[type="text"]
          flex 1
          margin 0
          padding .5rem .75rem
          background none
          border none
          outline none
          color white
          font-size .8rem
        > button
          display flex
          align-items center
          flex 0 0 auto
          padding 0 .75rem
          background none
          border none
          outline none
          color white
          opacity .5

  #map-flow
    display flex
    position relative
    flex-direction column
    flex 1
    z-index 1
    #map
      position relative
      flex 1
      background c_map_bg
      z-index 1
    #boxes
      display flex
      flex-direction column
      padding 15px
      background black
      box-shadow 0 0 20px alpha(black, .5)
      z-index 2

  .box
    display flex
    flex-direction column
    background #333
    border-radius 10px
    color white
    .box-title
      display flex
      align-items center
      padding 15px
      font-weight bold
      opacity .5
      > strong
        margin 0 .5em
      > code
        margin 0 0 0 auto
        font-family f_mono
        font-style normal
    .box-body
      padding 0 15px
      &.box-body-only
        padding 15px
      p
        margin 0
        padding 0
        font-size .9rem
        &.box-highlight
          margin-bottom 10px
          font-size 1.1rem
          font-weight bold
          &:last-child
            margin-bottom 0
    .box-footer
      display flex
      flex-direction column
      padding 15px

    button
      bt()
      &.stretch
        bt-stretch()
      &.primary
        bt-primary()

    .buttons
      display flex
      flex 1
      margin 0 -5px
    .alt-buttons
      display flex
      flex 1
      margin 0 0 1rem -1px
      &:last-child
        margin-bottom 0
      button
        margin 0 0 0 1px
        padding 7px 5px
        font-size .75rem
        font-weight normal
        &:not(:first-child)
          border-top-left-radius 0
          border-bottom-left-radius 0
        &:not(:last-child)
          border-top-right-radius 0
          border-bottom-right-radius 0

#console
  align-self start
  flex 1
  padding 3rem
  background alpha(black, .75)
  color white
  ul
  ol
  li
    margin 0
    padding 0
    list-style none
  ul
    margin 1rem
    > li
      display flex
      > strong
        flex 0 0 5.5rem
      > em
        flex 1
        font-family f_mono
        font-style normal
        user-select all
        cursor pointer
  ol.console-app-instances
    > li.console-app-instance
      margin 0 0 1rem 0
      border 1px solid white
      border-radius 10px
      > div
        > strong
          display block
          padding 1rem
          border-bottom 1px solid white
          text-align center
      > ol.console-maps
        padding 1rem
        border-top 1px solid white
        > li.console-map
          border 1px solid alpha(white, .35)
          border-radius 8px
          > div
            > strong
              display block
              padding 1rem
              border-bottom 1px solid alpha(white, .35)
              text-align center
            > div
              &.console-map-actions
                display flex
                padding 1rem .5rem
                border-top 1px solid alpha(white, .35)
                > a
                  bt()
                  bt-primary()
